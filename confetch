#!/bin/sh

# This fetch never lies, so you should always trust it.
# No need to edit this file unless yuore STUPID and want it to break.

version="version 1.8"

# decides what modules are in the output
# the order changes depending on this aswell just so yk
enabled="
title 
distro 
wm
kernel
shell 
init
packages
uptime
terminal
host
memory
cpu
gpu
"

# remove a module from $enabled and put it into $disabled to disable it
disabled="
"

# these are for the 2 different thinigies colours
# keep as auto for automatic colouring according to your distro
keycolour="auto"
accentcolour="auto"

# gets your distro. Needed before logooption
. /etc/os-release
distro=$PRETTY_NAME
distroShort=$NAME

# this is for changing the logo
# for a list of logos, use "confetch -h logo"
# i dont plan on making logos for forks unless i decide otherwise.
# this includes distros like mint, artix, pop, cachy, zorin, endeavor, etc.
logooption="$distro"

# past here is where the ugly ugly magic happens. Do NOT go further unless youre me.
# when writing this, only me and god knew what i was writing. Now only i know.

# bold
bld=$(printf '\033[1m')
# reset
rst=$(printf '\033[0m')
# foreground
fg=$(printf '\033[0m\033[1m')

# black
C30=$(printf '\033[30m')
# red
C31=$(printf '\033[31m')
# green
C32=$(printf '\033[32m')
# yellow
C33=$(printf '\033[33m')
# blue
C34=$(printf '\033[34m')
# purple
C35=$(printf '\033[35m')
# cyan
C36=$(printf '\033[36m')
# white
C37=$(printf '\033[37m')

# bright black
C90=$(printf '\033[90m')
# bright red
C91=$(printf '\033[91m')
# bright green
C92=$(printf '\033[92m')
# bright yellow
C93=$(printf '\033[93m')
# bright blue
C94=$(printf '\033[94m')
# bright purple
C95=$(printf '\033[95m')
# bright cyan
C96=$(printf '\033[96m')
# bright white
C97=$(printf '\033[97m')

hostname=$(uname -n)
lineCount=0
asciiLineCount=0

kernelType=$(uname -s)

os=$(
	case "$kernelType" in
		[Ll]inux)
			echo "Linux"
			;;
		*[Bb][Ss][Dd] | [Dd]ragon[Ff]ly)
			echo "BSD"
			;;
		*)
			echo "tf are you using?"
			;;
	esac
)

addLine() {
    lineCount=$((lineCount + 1))
    eval "line_$lineCount=\$1"
}

asciiAddLine() {
	asciiLineCount=$((asciiLineCount + 1))
	eval "ascii_$asciiLineCount=\$1"
}

colouroption() {
    case "$2" in
        red)    eval "$1=\$C31" ;;
        blue)   eval "$1=\$C34" ;;
        green)  eval "$1=\$C32" ;;
        yellow) eval "$1=\$C33" ;;
        cyan)   eval "$1=\$C36" ;;
        purple) eval "$1=\$C35" ;;
        white)  eval "$1=\$C37" ;;
        black)  eval "$1=\$C30" ;;
        foreground) eval "$1=\$foreground" ;;
        *)
            echo "whats that colour: '$2'?"
            exit 1
            ;;
    esac
}

setAutoColour() {
    [ "$keycolour" = "auto" ] && keycolour=$1
    [ "$accentcolour" = "auto" ] && accentcolour=$2
}

randomlogo() {
	read -r up _ < /proc/uptime
	num=$(( ${up%%.*} % 27 ))

	case "$num" in
	    0) logooption="tux" ;;
	    1) logooption="debian" ;;
	    2) logooption="void" ;;
	    3) logooption="arch" ;;
	    4) logooption="gentoo" ;;
	    5) logooption="fedora" ;;
	    6) logooption="nix" ;;
	    7) logooption="alpine" ;;
	    8) logooption="dragonfly" ;;
	    9) logooption="suse" ;;
	    10) logooption="netbsd" ;;
	    11) logooption="freebsd" ;;
	    12) logooption="openbsd" ;;
	    13) logooption="plan9" ;;
	    14) logooption="gnu" ;;
	    15) logooption="guix" ;;
	    16) logooption="crux" ;;
	    17) logooption="exherbo" ;;
	    18) logooption="nerv" ;;
	    19) logooption="seele" ;;
	    20) logooption="navi" ;;
	    21) logooption="aperture" ;;
	    22) logooption="lambda" ;;
	    23) logooption="blackmesa" ;;
	    24) logooption="chimera" ;;
	    25) logooption="ubuntu" ;;
	    *) logooption="trash" ;;
	esac
}

helpoptions() {
	case "$1" in
		logo)
			echo "  logo options:"
			echo "    tux, debian, nix, void, arch, fedora, freebsd,"
			echo "    alpine, slackware, chimera, dragonfly, suse, netbsd,"
			echo "    openbsd, plan9, gentoo, gnu, guix, crux, exherbo,"
			echo "    nerv, seele, navi, blackmesa, lambda, aperture,"
			echo "    and trash (fallback)"
			;;
		accent)
			echo "  accent options:"
			echo "    white, purple, blue, cyan, green, yellow, red,"
			echo "    black, and foreground"
			;;
		key)
			echo "  key options:"
			echo "    white, purple, blue, cyan, green, yellow, red,"
			echo "    black, and foreground"			;;
		version)
			echo "  nothing to help with... what??"
			echo "    are you stupid?"
			;;
		larp)
			echo "  larp options:"
			echo "    with logos: everything that --logo has"
			echo "    ^^ except for the non distros like seele or lamda"
			echo "    without correct logos: anything lol"
			;;
		confused)
			echo "  i get that youre a lil confused"
			echo "    but this doesnt have options"
			;;
		*)
			echo "  what? Wtf do you need help with??"
			;;
	esac
}

while [ $# -gt 0 ]; do
	case "$1" in
		--version|-v)
			echo "$version"
			exit 0
			;;
		--logo|-l)
			logooption="$2"
			shift 2
			;;
		--key|-k)
			colouroption keycolour "$2"
			shift 2
			;;
		--accent|-a)
			colouroption accentcolour "$2"
			shift 2
			;;
		--larp|-L)
			logooption="$2"
			distroShort="$2"
			distro="$2"
			shift 2
			;;
		--confused|-C)
			randomlogo
			shift
			;;
		--help|-h)
			cat <<EOF
			
  Usage: confetch [options]

    -h, --help FLAG       | helps you out
    -v, --version         | prints the version
    -l, --logo NAME       | well wtf do you THINK it does, huh??
    -a, --accent COLOUR   | changes your accent irl
    -k, --key COLOUR      | changes your house keys
    -C, --confused        | confuses you
    -L. --larp NAME       | sudo W opsec. Larpity larp

EOF
			helpoptions "$2"
			echo
			exit 0
			;;
		*)
			echo "that isnt a command buddy: $1"
			exit 1
			;;
	esac
done

case "$distro" in 
	*[Vv]oid*)
		distroecho="$USER died to the void"
		setAutoColour "$C32" "$fg"
		;;
	*[Aa]rch*)
