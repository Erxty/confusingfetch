		;;
	*)
		distroecho="ay this isnt supported! Stop using confetch!!"
		setAutoColour "$C31" "$C31"
		;;
esac

for module in $enabled; do
	case " $disabled " in
		*" $module "*) continue ;;
	esac

	case "$module" in

		title)
			titlekey="sudo apt ddos"
		  	title="${bld}${accentcolour}$USER${fg}@${bld}${accentcolour}${hostname}${rst}"
		  	title="   ${rst}${titlekey}${rst} ${title}"
		  	addLine "$title"
			;;

		distro)
			distrokey="${distroecho}"
			distromod="${distroShort} user BTW"
			distromod="${bld}${keycolour}${distrokey}${rst} = ${distromod}"
		  	addLine "$distromod"
			;;

		wm)
		 	wm="something niche probably"
	 		case "$WAYLAND_DISPLAY" in
	    		"")
	    			case "$XAUTHORITY" in
	    			"")
	    				server="TTY"
	    				wmkey="no window to manager"
	    				;;
	    			*)
		        		server="X11"
		        		wmkey="window manager"
		        		;;
		        	esac
    		    		;;
	    		*)
		         	server="Wayland"
		         	wmkey="compositor"
    		    		;;
		 	esac
	 		wm="${bld}${keycolour}${wmkey}${rst} = ${wm} (${server})"
		  	addLine "$wm"
			;;

		shell)
			shell="${SHELL##*/}"
	 		shellkey="like.. a seashell?"
		 	shell="${bld}${keycolour}${shellkey}${rst} = ${shell}"
		 	addLine "$shell"
			;;

		init)
			init="$(cat /proc/1/comm)"
			initkey="personal identity disorder 1"
			init="${bld}${keycolour}${initkey}${rst} = ${init}"
			addLine "$init"
			;;

		kernel)
			kernel=$(uname -r )
			kernelkey="highest ranking non-general grade officer"
			kernel="${bld}${keycolour}${kernelkey}${rst} = ${kernel}"
		  	addLine "$kernel"
			;;

		host)
			host=$(cat /sys/devices/virtual/dmi/id/product_name)
			hostkey="rock that can think"
			host="${bld}${keycolour}${hostkey}${rst} = ${host}"
			addLine "$host"
			;;

		uptime)
			case "$os" in
				Linux)
					read -r uptime _ < /proc/uptime
					uptime_seconds=${uptime%%.*}
					;;
				BSD)
					uptime=$(sysctl -n kern.boottime | cut -d',' -f1 | cut -d ' ' -f4)
					uptime_now=$(date +%s)
					uptime_seconds=$((uptime_now - uptime))
					;;
			esac

			uptime_minutes=$(( $uptime_seconds / 60 ))
			uptime_hours=$(( $uptime_minutes / 60 ))
			if [ "$uptime_hours" -ge 10 ]; then
				uptimekey="ew get off your computer wtf. Youve been on for"
				uptime="${uptime_hours} hours"
			elif [ "$uptime_hours" -ge 5 ]; then
				uptimekey="go touch some grass, ok?"
				uptime="${uptime_hours} hours"
			elif [ "$uptime_hours" -ge 2 ]; then 
				uptimekey="get off soon, alr?"
				uptime="${uptime_hours} hours"
			elif [ "$uptime_hours" -ge 1 ]; then
				uptimekey="keep on using that computer, computer boy."
				uptime="${uptime_minutes} minutes"
			elif [ "$uptime_minutes" -ge 30 ]; then
				uptimekey="wow, not too much, huh? "
				uptime="${uptime_minutes} minutes"
			else 
				uptimekey="computah, slime this guy out. "
				uptime="${uptime_minutes} minutes"
			fi
			uptime="${bld}${keycolour}${uptimekey}${rst} ${uptime}"
		  	addLine "$uptime"
			;;

		packages)
			case "$os" in
				Linux)
					packages=$(
						if command -v apt-get > /dev/null 2>&1; then
		   					dpkg-query -f '.\n' -W | wc -l
						elif command -v pacman > /dev/null 2>&1; then
				   			pacman -Qq | wc -l
						elif command -v dnf > /dev/null 2>&1; then
				   			rpm -qa --queryformat '.\n' | wc -l
						elif command -v zypper > /dev/null 2>&1; then
		   					rpm -qa --queryformat '.\n' | wc -l
						elif command -v xbps-query > /dev/null 2>&1; then
							xbps-query -l | wc -l
						elif command -v emerge > /dev/null 2>&1; then
							ls /var/db/pkg/*/* -d | wc -l
						elif command -v apk > /dev/null 2>&1; then
							grep 'P:' /lib/apk/db/installed | wc -l
						elif command -v nix-env > /dev/null 2>&1; then
							nix-env --query | wc -l
						else
				   			echo "no"
						fi
						)
					;;
				BSD)
					packages=$(
						if command -v pkg > /dev/null 2>&1; then
							pkg info -a | wc -l
						fi
						)
					;;
			esac

			if [ "$packages" != "no" ]; then
				packages_low=$(( $packages * 10 / 12 ))
				packages_high=$(( $packages * 16 / 10 ))
				packages="prolly like ${packages_low} to ${packages_high}"
			else
				packages="stop using a niche distro ya bum"
			fi
			packageskey="aliexpress packages"
			packages="${bld}${keycolour}${packageskey}${rst} = ${packages}"
		  	addLine "$packages"
			;;

		terminal)
			case "$TERM" in
				*foot*)
					terminalkey="mghh.. feet :drooling_face: term"
					terminal="yummy in my tummy"
				;;
				*kitty*)
					terminalkey="kitty? i like them. term"
					terminal="cat"
				;;
				*rxvt-unicode*)
					terminalkey="the best x11 term btw. term"
					terminal="urxvt"
				;;
				*xterm*)
					terminalkey="why are you using this..? term"
					terminal="$TERM"
				;;
				*)
					terminalkey="prolly a bad term"
					terminal="$TERM"
				;;
			esac
			terminal="${bld}${keycolour}${terminalkey}${rst} = ${terminal}"
		  	addLine "$terminal"
			;;

		cpu)
			case "$os" in
				Linux)
	 				cpu=$( awk -F ': ' '/model name*:*/{print $2; exit}' /proc/cpuinfo )
	 				;;
	 			BSD)
	 				case "$kernelType" in
                				[Ff]ree[Bb][Ss][Dd]* | [Dd]ragon[Ff]ly* | [Nn]et[Bb][Ss][Dd]*)
	 						cpu=$( sysctl -n hw.model )
	 						;;
	 					[Oo]pen[Bb][Ss][Dd])
	 						;;
	 				esac
	 				;;
	 		esac
		 	cpukey="cpu"
	 		cpu="${space}${bld}${keycolour}${cpukey}${rst} = ${cpu}"
		  	addLine "$cpu"
			;;

		gpu)
			case "$os" in
				Linux)
                gpuNumber=$(lspci -k | grep -Ei "(VGA|3D|DISPLAY)" | awk '{print $1; exit}');
                if read -r -n1 -d '' < <(lspci -v -s "${gpuNumber}" | awk -F': ' '/Subsystem:/{print $2}' | grep -Ei "RTX|GTX|RX|XT|RADEON"); then
                    gpu=$(lspci -v -s "${gpuNumber}" | awk -F': ' '/Subsystem:/{print $2}' | grep -Ei "RTX|GTX|RX|XT|RADEON");
                else    
                    gpu=$(lspci -v -s "${gpuNumber}" | awk NR==1 | grep -oP '\[.*?\]' | awk NR==1 | sed 's/^.\(.*\).$/\1/');
                fi
                ;;
				BSD)
					gpu=$( pciconf -lv | grep -B 4 -F "VGA" | grep -E "^[[:space:]]+device[[:space:]]*=" | cut -d "'" -f2 )
					;;
			esac
			gpukey="gpu"
			gpu="${bld}${keycolour}${gpukey}${rst} = ${gpu}"
		  	addLine "$gpu"
			;;
		
		ram)
			case "$os" in
				[Ll]inux)
    					while read -r key value unit; do
		       		 		[ "$key" = "MemTotal:" ] && { ramTotal=$value; break; }
		    			done < /proc/meminfo
		    			while read -r key value unit; do
        					[ "$key" = "MemAvailable:" ] && { ramAvail=$value; break; }
		    			done < /proc/meminfo
		    			;;
		    		[Ff]ree[Bb][Ss][Dd])
		    			ramTotal="$(( $( sysctl -n hw.physmem) / 1000 ))"
		    			hwPage="$( sysctl -n hw.pagesize)"
		  	  		ramInac="$(( $( sysctl -n vm.stats.vm.v_inactive_count) * hwPage ))"
		    			ramCache="$(( $( sysctl -n vm.stats.vm.v_cache_count) * hwPage ))"
		    			ramFree="$(( $( sysctl -n vm.stats.vm.v_free_count) * hwPage ))"
		    			ramAvail="$(( (ramInac + ramFree + ramCache) / 1000 ))"
		    			;;
		    	esac	
    			ramTotal_GB_full=$(( ramTotal / 1000000 ))
	    		ramTotal_clean=$(( ramTotal / 1000000 * 1000000 ))

    			ramUsed=$(( ramTotal_clean - ramAvail ))
    		
			    ramUsed_hundreth=$(( ramUsed / 10000 ))
		   	ramUsed_GB="$(( ramUsed_hundreth / 100 )).$(( ramUsed_hundreth % 100 ))"

			ram=$(
        			if [ "$ramTotal_GB_full" -ge 63 ]; then
					echo "${ramUsed_GB}GB/${ramTotal_GB_full}GB?? sharing is caring btw"
			        elif [ "$ramTotal_GB_full" -ge 31 ]; then
					echo "${ramUsed_GB}GB/${ramTotal_GB_full}GB, a couple browser tabs worth"
        			elif [ "$ramTotal_GB_full" -ge 15 ]; then
					echo "${ramUsed_GB}GB/${ramTotal_GB_full}GB, pretty average tbh"
        			elif [ "$ramTotal_GB_full" -ge 7 ]; then
					echo "${ramUsed_GB}GB/${ramTotal_GB_full}GB, you better hope GTA 6 never releases"
				else
					echo "only ${ramUsed_GB}GB/${ramTotal_GB_full}GB..? treat yourself, please"
				fi
			)
    			ramkey="ai food"
    			ram="${bld}${keycolour}${ramkey}${rst} = ${ram}"
    			addLine "$ram"
    			;;

	esac
done

