	*[Ff]edora*)
		asciiAddLine "${bld}${C34}     _*#####*_    "
		asciiAddLine "${bld}${C34}    /${fg}    __${C34}   \   "
		asciiAddLine "${bld}${C34}   $ ${fg}   |  |${C34}   $  "
